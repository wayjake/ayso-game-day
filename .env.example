# Database
DATABASE_URL=file:./data/dev.db

# Session security (generate a secure random string)
SESSION_SECRET=your-secret-key-here

# UploadThing (for image uploads)
UPLOADTHING_TOKEN=your-uploadthing-token-here

# OpenAI (for AI Assistant Coach)
OPENAI_API_KEY=your-openai-api-key-here

# Turso. Leave TURSO_URL/TURSO_TOKEN unset locally: when set, the app and
# drizzle-kit use them instead of DATABASE_URL
# TURSO_URL=
# TURSO_TOKEN=
# Production, for db:prod:migrate and db:prod:studio
# TURSO_PROD_URL=
# TURSO_PROD_TOKEN=

# Email (Resend): sending, receiving and the webhook at /api/email/webhook.
# Use a full-access key: a sending-only key can't fetch received email.
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
RESEND_WEBHOOK_SECRET=
# Outside production, family emails go to the sending coach unless this is true
# EMAIL_DELIVER_TO_FAMILIES=true

# Realtime chat (Ably). The key needs Publish, Subscribe and Presence
ABLY_API_KEY=

# Web Push. Generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Origin used in invite links
APP_URL=
